# Leave a key empty to run that side in DEMO mode (fixtures / template output).
SERPAPI_API_KEY=
# LLM: set any of these. Tried in order: Groq, then Gemini, then Claude; rules if all fail.
# Groq is free (console.groq.com): 1,000 requests/day per model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded (503).
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=
# 1 forces DEMO for both, even when keys are set.
LEADLOOP_DEMO=0
# Hard stop on live SerpApi searches (free plan: 250/month). Cached responses are free.
LEADLOOP_CREDIT_BUDGET=200

# --- Markets --------------------------------------------------------------------
# Job and news searches run once per market (each search costs 1 SerpApi credit the first time).
# Known: India, United States, United Kingdom, Canada, Australia, Singapore, United Arab Emirates.
LEADLOOP_MARKETS="India,United States"
# Currency for leads with no country (e.g. Reddit posters).
DEFAULT_CURRENCY=USD

# --- Email -------------------------------------------------------------------
# sandbox: every email goes to Mailpit (http://localhost:8025), nothing leaves your machine.
# live:    sends through the SMTP account below (real inboxes!).
LEADLOOP_SEND_MODE=sandbox
LEADLOOP_SENDER="Your Data Desk <data.desk@yourdomain.com>"
LEADLOOP_SIGNATURE="Your Data Desk"
LEADLOOP_DAILY_SEND_CAP=25
# Sending: Brevo free SMTP (300/day). Username = the "Login" on Brevo > SMTP & API > SMTP,
# password = an SMTP key generated on that page. The From address must be verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Reading replies over IMAP needs a paid Zoho plan. Leave IMAP_HOST empty to paste replies on the board.
# After upgrading Zoho: IMAP_HOST=imappro.zoho.in, IMAP_PORT=993, IMAP_USER=data.desk@yourdomain.com, IMAP_PASSWORD=<app password>
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Pricing rules. The agent can never quote outside these. --------------------
# India (INR)
PRICE_PER_ROW_INR=4
MIN_ORDER_INR=1500
# US and other markets (USD)
PRICE_PER_ROW_USD=0.10
MIN_ORDER_USD=49
# Both currencies
DEFAULT_ROWS=500
DISCOUNT_STEP_PCT=10
MAX_DISCOUNT_PCT=20
MAX_FOLLOWUPS=2
FOLLOWUP_AFTER_DAYS=3

# --- Fulfilment: building the order once a lead accepts ---------------------------
# SerpApi searches one order may spend (Google Maps pages + enrichment).
FULFIL_MAX_SEARCHES=50
# Top rows that get review topics and a hiring check (2 searches each).
FULFIL_ENRICH_ROWS=10
# What one search costs you (Developer plan: $75 / 5,000), for each order's margin.
SERP_COST_PER_SEARCH_USD=0.015
USD_TO_INR=88
